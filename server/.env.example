# Copy this file to server/.env and fill in the values. Never commit server/.env.

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# The "service_role" (secret) key. Server only. Never put this in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# Port for local development
PORT=4000

# Phase 5: require an SMS-confirmed phone number to report / confirm fixes (one account per phone).
# Turn on only after Twilio Verify is set up in Supabase and tested.
REQUIRE_PHONE_VERIFICATION=false

# Phase 6 (Safe Route): free key from https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
