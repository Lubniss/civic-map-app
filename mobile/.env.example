# Copy this file to mobile/.env and fill in the values. Never commit mobile/.env.

# Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# The "anon" (public) key. Safe to ship in the app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Our Express server. During development: this PC's local network address, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://YOUR-PC-IP:4000
